# =============================================================================
# Nova Chain .gitignore
# 原则：不忽略任何源码；忽略构建产物、本地环境与敏感凭据。
# 敏感信息（私钥/助记词/token/API key）永远不得提交（Master Prompt §18/§19）。
# =============================================================================

# --- Rust 构建产物 ---
/target
**/*.rs.bk

# --- 本地环境变量（示例文件可提交） ---
.env
.env.*
!.env.example

# --- 敏感凭据与密钥（绝对禁止入库） ---
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
**/keystore/
*.mnemonic
*.seed
credentials.json

# --- 数据库 / 运行时数据 ---
*.db
*.db-journal
*.sqlite
data/
*.rocksdb/

# --- 前端 / 业务产物 ---
node_modules/
dist/
build/
*.local

# --- 编辑器 / 系统 ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- 日志（结构化日志不应入库） ---
*.log
logs/
# --- Nova Web (independent repo, do not track) ---
nova-web/

# --- Python 缓存（simulation 本地研究产物，NON-PROTOCOL） ---
__pycache__/
*.pyc
