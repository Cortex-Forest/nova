# syntax=docker/dockerfile:1.7
#
# Minimal one-service Testnet Seed image:
# - embeds only the Owner-approved public Genesis artifact;
# - creates a random network identity seed on the persistent volume at first
#   start, then execs the existing node binary;
# - does not embed any seed, private key, mnemonic or keystore;
# - starts as root only long enough to prepare the platform-created volume,
#   then replaces itself with the node running as UID/GID 10001.

FROM --platform=linux/amd64 rust:1.96.1-alpine@sha256:f5c84c3751de59f0f318acfbed8b2d04693a12d9171f15835d9c11c9ddcf52db AS builder

WORKDIR /src
RUN cc --version > /dev/null

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/
COPY tests/vectors/ ./tests/vectors/

RUN CARGO_TERM_COLOR=never cargo build --release -p nova-node \
      --bin yazimao-node \
      --bin nova-seed-init \
      --bin nova-validator-start \
      --bin nova-validator-init \
      --locked

FROM --platform=linux/amd64 scratch AS runtime

COPY --from=builder --chown=0:0 --chmod=0755 /src/target/release/yazimao-node /usr/local/bin/yazimao-node
COPY --from=builder --chown=0:0 --chmod=0555 /src/target/release/nova-seed-init /usr/local/bin/nova-seed-init
COPY --from=builder --chown=0:0 --chmod=0555 /src/target/release/nova-validator-start /usr/local/bin/nova-validator-start
COPY --from=builder --chown=0:0 --chmod=0555 /src/target/release/nova-validator-init /usr/local/bin/nova-validator-init
COPY --chown=0:0 --chmod=0755 genesis.bin /read-only/genesis/.keep
COPY --chown=0:0 --chmod=0444 genesis.bin /read-only/genesis/genesis.bin
COPY --chown=0:0 --chmod=0444 genesis_hash.txt /read-only/genesis/genesis_hash.txt

LABEL org.opencontainers.image.title="yazimao-node-testnet-seed" \
      org.opencontainers.image.description="YAZIMAO Testnet Seed node with frozen Genesis and first-boot network identity generation" \
      org.opencontainers.image.source="https://github.com/Cortex-Forest/nova" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="0.1.0" \
      io.yazimao.genesis.sha256="7d1ec6b9fccceb042e5948a9ca90d984836d57189ffdfd3c00850a82bca54e3d"

USER 0:0
ENTRYPOINT ["/usr/local/bin/nova-seed-init"]
CMD []
