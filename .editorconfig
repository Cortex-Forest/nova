# Nova Chain EditorConfig（跨编辑器统一风格）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2
